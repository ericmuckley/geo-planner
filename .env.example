# Recommended Vercel/US setup: docs/us-routing-service.md.
# Server-only free Standard key from https://account.heigit.org/.
# ROUTING_PROVIDER=openrouteservice
# ORS_API_KEY=
# Hosted driving cap is 60 minutes; VALHALLA_* settings do not raise it.

# Optional self-hosted fallback. Default provider without ROUTING_PROVIDER is valhalla.
# Server-only. Use the base URL, without /isochrone. Optional until a graph exists.
# Reproducible San Diego–Tijuana setup: docs/regional-routing.md.
# npm run dev:routing loads generated data/valhalla-v2/app.env without editing .env.local.
# VALHALLA_URL=http://localhost:8002
VALHALLA_MAX_MINUTES=120
# Record the actual engine build and graph snapshot before collecting benchmarks.
# VALHALLA_ENGINE_VERSION=
# VALHALLA_GRAPH_VERSION=
# VALHALLA_COVERAGE=Southern California; boundary completeness unverified
# Optional JSON [west,south,east,north]; rejects origins outside the declared region.
# This is an origin guard, not proof of complete road coverage or complete contours.
# VALHALLA_COVERAGE_BOUNDS=[-119.8,30.8,-114.5,35.5]

# Optional browser-visible URL to a Protomaps-compatible regional PMTiles archive.
# Absolute http(s) URL, or a same-origin path. Requires HTTP Range support and CORS.
# VITE_PMTILES_URL=/maps/southern-california.pmtiles
# Defaults to OpenFreeMap when no archive is configured.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Protomaps assets may also be self-hosted:
# VITE_MAP_GLYPHS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf
# VITE_MAP_SPRITE_URL=https://protomaps.github.io/basemaps-assets/sprites/v4/light

# Optional existing Drizzle/PostgreSQL connection; not needed by this first slice.
# DATABASE_URL=postgresql://user:password@localhost:5432/geo_planner
