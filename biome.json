{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/scripts/**/*.ts",
			"**/scripts/**/*.mjs",
			"**/routing/**/*.mjs",
			"**/routing/manifest.json",
			"**/routing/profiles/*.json",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/server/data/coarse-grid-v1.json",
			"!**/src/server/data/coarse-grid-v2.json",
			"!**/src/server/data/coarse-grid-v3.json",
			"!**/src/server/data/coarse-grid-v4.json",
			"!**/src/server/data/coarse-grid-v5.json",
			"!**/src/server/data/coarse-grid-v6.json",
			"!**/src/server/data/coarse-grid-v7.json",
			"!**/src/server/data/coarse-grid-v8.json",
			"!**/src/server/data/coarse-grid-v9.json",
			"!**/src/styles.css",
			"!data"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": [
				"scripts/coarse_osm_geometric_snap_v1.ts",
				"scripts/coarse_osm_geometric_snap_v1_test.ts",
				"scripts/coarse_osm_paid_geometry_loader_v1_test.ts",
				"scripts/pack_osm_paid_geometry_v1.ts",
				"scripts/profile_osm_paid_geometry_v1.ts"
			],
			"assist": { "actions": { "source": { "organizeImports": "off" } } }
		}
	]
}
