{
  "name": "geo-planner",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
	"dev:experiment": "node routing/experiment.mjs",
	"routing:experiment:coverage": "node routing/experiment-coverage.mjs",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "check:vercel": "node routing/app.mjs check-vercel",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server/*.test.ts",
    "routing:download": "node routing/download.mjs",
    "routing:build": "node routing/prepare.mjs && node routing/service.mjs build",
    "routing:up": "node routing/service.mjs up",
    "routing:down": "node routing/service.mjs down",
    "routing:verify": "node routing/app.mjs verify",
    "routing:verify:hosted": "node --import tsx routing/verify-hosted.mjs",
    "routing:anchors": "node routing/anchors.mjs",
    "routing:reference": "node routing/reference.mjs",
    "routing:cells": "node routing/cells.mjs",
    "routing:native": "node routing/native.mjs",
    "routing:model": "node routing/model.mjs",
    "routing:model:verify": "sandbox-exec -f routing/native-network.sb python3 -B routing/model_native.py",
    "routing:regional": "node routing/regional.mjs",
    "routing:regional:rebuild": "node routing/regional-rebuild.mjs",
    "routing:regional:verify": "sandbox-exec -f routing/native-network.sb python3 -B routing/regional_native.py",
    "routing:barriers": "node routing/barriers.mjs",
    "routing:barriers:rebuild": "node routing/barriers.mjs --stage rebuild",
    "routing:barriers:verify": "sandbox-exec -f routing/native-network.sb python3 -B routing/barriers_native.py",
    "routing:import": "node routing/import-capacity.mjs",
    "routing:import:verify": "sandbox-exec -f routing/native-network.sb python3 -B routing/import_native.py",
    "routing:wide": "node routing/wide.mjs",
    "routing:wide:rebuild": "node routing/wide.mjs --stage rebuild",
    "routing:wide:verify": "sandbox-exec -f routing/native-network.sb python3 -B routing/barriers_native.py --run-name san-diego-tijuana-wide-v3",
    "routing:coverage": "node routing/coverage-preflight.mjs",
    "routing:compact": "node routing/compact.mjs",
    "routing:compact:verify": "sandbox-exec -f routing/native-network.sb python3 -B routing/compact_native.py",
    "routing:compact:reload": "node routing/compact-reload.mjs",
    "routing:inputs": "node routing/input-storage.mjs",
    "routing:cuts": "node routing/cut-inventory.mjs",
    "routing:coverage:next": "node routing/buffer-preflight.mjs",
    "routing:resources": "node routing/import-resource-probe.mjs",
    "routing:tools:sparse": "node routing/sparse-tools.mjs",
    "routing:sparse": "node routing/sparse-prepare.mjs",
    "routing:paged": "node routing/paged-import.mjs",
    "routing:sparse:paged": "node routing/sparse-paged-prepare.mjs",
    "routing:increment": "node routing/increment.mjs",
    "routing:increment:qualify": "node routing/increment-qualify.mjs",
    "routing:qualify:lean": "node routing/lean-qualification.mjs",
    "routing:coverage:hour": "node routing/hour-preflight.mjs",
    "routing:hour": "node routing/hour-increment.mjs",
    "routing:coverage:two-hour": "node routing/two-hour-preflight.mjs",
    "routing:outgoing": "node routing/outgoing-parity.mjs",
    "routing:xml": "node routing/xml-parity.mjs",
    "routing:base-ids": "node routing/base-ids-parity.mjs",
    "routing:evidence": "node routing/evidence-parity.mjs",
    "routing:members": "node routing/member-parity.mjs",
    "routing:io:bounded": "node routing/io-bounded-parity.mjs",
    "routing:io": "node routing/io-parity.mjs",
    "routing:keys": "node routing/keyed-parity.mjs",
    "routing:lifetime": "node routing/lifetime-preflight.mjs",
    "test:routing": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s routing -p '*_test.py'",
    "dev:routing": "node routing/app.mjs dev",
    "preview:routing": "node routing/app.mjs preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:verify": "node --import tsx scripts/verify-saved-history.ts",
    "data:coarse": "python3 -B scripts/build-coarse-grid-v3.py",
    "test:coarse-data": "python3 -B -m unittest discover -s scripts -p 'coarse_*_test.py'",
    "routing:verify:coarse": "node --import tsx scripts/verify-coarse.ts",
    "routing:compare:coarse": "node --import tsx scripts/compare-coarse.ts",
    "routing:compare:coarse:v2": "node --import tsx scripts/compare-coarse-v2.ts",
    "routing:compare:coarse:regional": "node --import tsx scripts/compare-coarse-regional.ts",
    "routing:compare:coarse:candidate": "node --import tsx scripts/compare-coarse-candidate.ts",
    "check:coarse:vercel": "node scripts/verify-coarse-vercel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@protomaps/basemaps": "^5.7.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.14.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "pmtiles": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
